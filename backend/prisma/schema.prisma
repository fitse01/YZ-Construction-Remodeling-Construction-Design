// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  RESTAURANT
  KITCHEN
  BATHROOM
  INTERIOR
  EXTERIOR
  FURNITURE_CARPENTRY
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ServiceCategory {
  KITCHEN
  BATHROOM
  WHOLE_HOME
  RESTAURANT
  COMMERCIAL
  EXTERIOR
  CARPENTRY
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String
  name              String
  profileImageUrl   String?
  role              UserRole       @default(OWNER)
  refreshToken      String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lastLoginAt       DateTime?
  refreshTokens     RefreshToken[]
  
  @@map("users")
}

model Project {
  id              String          @id @default(uuid())
  title           String
  slug            String          @unique
  location        String?
  description     String          @db.Text
  category        ProjectCategory
  status          ProjectStatus   @default(DRAFT)
  displayOrder    Int             @default(0)
  featuredImageId String?         @unique
  completionDate  DateTime?
  clientName      String?
  isFeatured      Boolean         @default(false)
  tags            String[]
  videoUrl        String?
  videoThumbnailUrl String?
  youtubeUrl      String?
  uploadedVideo   String?
  beforeImageUrl  String?
  afterImageUrl   String?
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  publishedAt     DateTime?

  media           Media[]
  featuredImage   Media?          @relation("FeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)

  @@map("projects")
  @@index([category])
  @@index([status])
  @@index([displayOrder])
  @@index([slug])
  @@index([isFeatured])
}

model Media {
  id          String   @id @default(uuid())
  projectId   String?
  serviceId   String?
  journalId   String?
  folder      String?  @default("general") // 'projects', 'services', 'hero', 'gallery', 'testimonials', 'blog', 'logo', 'videos', 'documents'
  type        String   // 'image' or 'video'
  filename    String
  originalName String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  duration    Int?     // For videos in seconds
  path        String   // Full path on filesystem
  url         String   // Public URL
  thumbnailPath String?
  thumbnailUrl String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  journal     Journal?  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  featuredIn  Project? @relation("FeaturedImage")
  coverFor    Service?  @relation("ServiceCoverImage")
  heroFor     HomePage? @relation("HomePageHero")
  featuredInJournal Journal? @relation("JournalFeaturedImage")
  aboutOwnerContent AboutContent? @relation("AboutOwnerImage")
  aboutTeamMembers AboutTeamMember[] @relation("AboutTeamMemberImage")

  @@map("media")
  @@index([projectId])
  @@index([serviceId])
  @@index([journalId])
  @@index([folder])
  @@index([type])
}

model AboutContent {
  id                String   @id @default(uuid())
  ownerName         String
  ownerPosition      String
  ownerDescription   String   @db.Text
  ownerImageId      String?   @unique
  companyStory      String?   @db.Text
  mission          String?   @db.Text
  vision           String?   @db.Text
  values           String?   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ownerImage        Media?   @relation("AboutOwnerImage", fields: [ownerImageId], references: [id], onDelete: SetNull)

  @@map("about_content")
}

model AboutTeamMember {
  id            String   @id @default(uuid())
  name          String
  position      String
  description   String?  @db.Text
  imageId       String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  image         Media?   @relation("AboutTeamMemberImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@map("about_team_members")
  @@index([displayOrder])
  @@index([isActive])
}

model Message {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  projectType String?
  budget      String?
  timeline    String?
  message     String   @db.Text
  isRead      Boolean  @default(false)
  isArchived  Boolean  @default(false)
  isSpam      Boolean  @default(false)
  replyMessage String? @db.Text
  repliedAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("messages")
  @@index([isRead])
  @@index([isArchived])
  @@index([createdAt])
}

model Service {
  id              String           @id @default(uuid())
  title           String
  slug            String           @unique
  category        ServiceCategory
  shortDesc       String
  longDesc        String           @db.Text
  coverImageId    String?          @unique
  showOnHomepage  Boolean          @default(true)
  displayOrder    Int              @default(0)
  status          ContentStatus     @default(DRAFT)
  icon            String?
  timeline        String?
  features        String[]
  benefits        String[]
  tags            String[]
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?

  media           Media[]
  coverImage      Media?           @relation("ServiceCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)

  @@map("services")
  @@index([category])
  @@index([status])
  @@index([displayOrder])
  @@index([slug])
  @@index([showOnHomepage])
}

model Testimonial {
  id          String       @id @default(uuid())
  quote       String       @db.Text
  author      String
  location    String?
  rating      Int          @default(5)
  isFeatured  Boolean      @default(false)
  isVideo     Boolean      @default(false)
  videoUrl    String?
  status      ContentStatus @default(DRAFT)
  displayOrder Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  @@map("testimonials")
  @@index([status])
  @@index([isFeatured])
  @@index([displayOrder])
}

model SiteSettings {
  id                  String   @id @default(uuid())
  companyName         String
  tagline             String?
  ownerName           String
  email               String
  phone               String
  address             String?
  city                String?
  state               String?
  zip                 String?
  hours               String?
  logoUrl             String?
  faviconUrl          String?
  facebookUrl         String?
  instagramUrl        String?
  linkedinUrl         String?
  googleMapsUrl       String?
  metaTitle           String?
  metaDescription     String?
  googleAnalyticsId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("site_settings")
}

model HomePage {
  id                  String   @id @default(uuid())
  heroTitle           String
  heroSubtitle        String   @db.Text
  heroCtaText         String
  heroCtaLink         String
  heroImageId         String?  @unique
  statsTitle          String?
  statsSubtitle       String?  @db.Text
  servicesTitle       String
  servicesSubtitle    String   @db.Text
  projectsTitle       String
  projectsSubtitle    String   @db.Text
  testimonialsTitle   String
  testimonialsSubtitle String   @db.Text
  ctaTitle            String
  ctaSubtitle         String   @db.Text
  ctaButtonText       String
  ctaButtonLink       String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  heroImage           Media?   @relation("HomePageHero", fields: [heroImageId], references: [id], onDelete: SetNull)

  @@map("home_page")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("refresh_tokens")
  @@index([token])
  @@index([userId])
}

model Journal {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  shortDesc       String        @db.Text
  content         String        @db.Text // Full Rich Text Content
  category        String        // e.g. 'Guide', 'Case Study', etc.
  tags            String[]
  author          String        @default("Yohannes Z.")
  readingTime     String?       // e.g. '5 min read'
  publishDate     DateTime?     @default(now())
  status          ContentStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  featuredImageId String?       @unique
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  media           Media[]
  featuredImage   Media?        @relation("JournalFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)

  @@map("journals")
  @@index([status])
  @@index([slug])
  @@index([isFeatured])
}
