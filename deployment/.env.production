# Server Configuration
PORT=3001
NODE_ENV=production

# Database - PostgreSQL inside Docker container (port 5432)
DATABASE_URL="postgresql://yz_user:yz_password@localhost:5432/yz_construction?schema=public"

# JWT Secret Keys - Generate strong random strings for production (e.g. openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-openssl-rand-base64-32
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-use-openssl-rand-base64-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Domain URLs
FRONTEND_URL=https://yzbconstruction.com
ADMIN_DASHBOARD_URL=https://yzbconstruction.com

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=your-email@gmail.com
OWNER_EMAIL=owner-email@gmail.com

# File Upload Configuration
MAX_FILE_SIZE=52428800
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif,image/svg+xml
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime

# Upload Directory
UPLOAD_DIR=/var/www/yz-construction/backend/uploads
